<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>err403.SolutionManagment</id>
    <version>1.2026.4.10</version>
    <title>Solution Management (err403) for XrmToolBox</title>
    <authors>err403</authors>
    <owners>err403</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/garethcheyne/XrmToolkit.SolutionManagment</projectUrl>
    <icon>Icon.png</icon>
    <readme>docs\README.md</readme>
    <description>Transfer solutions, manage environment variables, and activate/deactivate cloud flows across Dataverse organisations.</description>
    <summary>Solution, environment variable, and cloud flow management across Dataverse environments.</summary>
    <releaseNotes>
      Cloud Flows tab, Environment Variables tab, managed/unmanaged warnings, docked UI.
    </releaseNotes>
    <tags>XrmToolBox Solutions Transfer EnvironmentVariables CloudFlows Dataverse</tags>
    <dependencies>
      <dependency id="XrmToolBox" version="1.2018.7.28" />
    </dependencies>
  </metadata>
  <files>
